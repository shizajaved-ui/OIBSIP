PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/pizzaDelivery
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Nodemailer (use a Gmail App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=admin@yourpizzashop.com

# Razorpay TEST keys (from dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Cloudinary (free tier) — makes admin-uploaded inventory photos persist
# across redeploys. Leave blank to fall back to local disk storage (fine for
# local dev, but uploads will NOT survive a Render redeploy without this).
# Get these from cloudinary.com -> Dashboard, after free signup.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CLIENT_URL=http://localhost:5173

# Low stock threshold (units)
LOW_STOCK_THRESHOLD=20
